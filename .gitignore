notes-builder/node_modules/
notes-builder/.quartz-cache/
notes-builder/quartz/.quartz-cache/
notes-builder/public/

# Original full-size photos; the site uses the resized copies in images/
/*.JPG
/*.jpg

.claude/
.DS_Store
__pycache__/
